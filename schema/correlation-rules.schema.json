{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yadidyc/HostSentinel/blob/main/schema/correlation-rules.schema.json",
  "title": "HostSentinel Sigma-subset correlation rule collection",
  "type": "array",
  "items": { "$ref": "#/$defs/document" },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "document": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" },
        "name": { "$ref": "#/$defs/nonempty" },
        "title": { "$ref": "#/$defs/nonempty" },
        "version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "detection": { "$ref": "#/$defs/detection" },
        "correlation": { "$ref": "#/$defs/correlation" }
      },
      "oneOf": [
        { "required": ["detection"] },
        { "required": ["correlation"] }
      ],
      "additionalProperties": false
    },
    "eventField": {
      "enum": [
        "host", "boot", "user", "session", "process", "parent_process",
        "source_id", "source", "category", "class", "activity",
        "src_ip", "dst_ip", "protocol"
      ]
    },
    "selection": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/eventField" },
      "additionalProperties": { "$ref": "#/$defs/nonempty" }
    },
    "detection": {
      "type": "object",
      "required": ["selection", "condition"],
      "properties": {
        "selection": { "$ref": "#/$defs/selection" },
        "condition": { "const": "selection" }
      },
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "properties": {
        "gt": { "type": "integer", "minimum": 1 },
        "gte": { "type": "integer", "minimum": 1 },
        "lt": { "type": "integer", "minimum": 1 },
        "lte": { "type": "integer", "minimum": 1 },
        "eq": { "type": "integer", "minimum": 1 },
        "neq": { "type": "integer", "minimum": 1 },
        "field": { "$ref": "#/$defs/nonempty" }
      },
      "oneOf": [
        { "required": ["gt"] }, { "required": ["gte"] },
        { "required": ["lt"] }, { "required": ["lte"] },
        { "required": ["eq"] }, { "required": ["neq"] }
      ],
      "additionalProperties": false
    },
    "aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "$ref": "#/$defs/eventField" }
      }
    },
    "identity": {
      "type": "object",
      "properties": {
        "same": {
          "type": "array", "uniqueItems": true,
          "items": { "enum": ["host", "boot", "user", "session", "process", "parent_process", "source_id"] }
        },
        "same-between": {
          "type": "array",
          "items": {
            "type": "object", "required": ["field", "rules"],
            "properties": {
              "field": { "enum": ["host", "boot", "user", "session", "process", "parent_process", "source_id"] },
              "rules": {
                "type": "array", "minItems": 2, "uniqueItems": true,
                "items": { "$ref": "#/$defs/nonempty" }
              }
            },
            "additionalProperties": false
          }
        },
        "missing": { "enum": ["reject", "indeterminate", "relaxed"] },
        "sources": { "enum": ["any", "same", "different"] },
        "parent-child": {
          "type": "array",
          "items": {
            "type": "object", "required": ["parent", "child"],
            "properties": {
              "parent": { "$ref": "#/$defs/nonempty" },
              "child": { "$ref": "#/$defs/nonempty" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "correlation": {
      "type": "object",
      "required": ["type", "rules", "timespan"],
      "properties": {
        "type": { "enum": ["event_count", "value_count", "temporal", "temporal_ordered"] },
        "rules": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/nonempty" }, "uniqueItems": true
        },
        "group-by": {
          "type": "array", "items": { "$ref": "#/$defs/nonempty" },
          "uniqueItems": true
        },
        "timespan": { "type": "string", "pattern": "^[1-9][0-9]*[smhdw]$" },
        "condition": { "$ref": "#/$defs/condition" },
        "aliases": { "$ref": "#/$defs/aliases" },
        "identity": { "$ref": "#/$defs/identity" }
      },
      "additionalProperties": false
    }
  }
}
